# Sao chép file này thành .env rồi chỉnh giá trị. Không commit file .env thật.

# --- API ---
# URL backend thật. Chỉ có tác dụng khi VITE_USE_MOCK_API=false (dùng làm target cho dev proxy /api, xem vite.config.js).
VITE_BASE_URL=http://localhost:3000
# Timeout cho mỗi request axios (ms).
VITE_API_TIMEOUT=30000

# --- Mock mode ---
# "false" = tắt mock, gọi backend thật qua proxy /api -> VITE_BASE_URL.
# Bất kỳ giá trị nào khác (hoặc bỏ trống) = bật mock (src/mocks/mockServer.js).
VITE_USE_MOCK_API=true

# --- Firebase Authentication ---
# Chỉ bắt buộc khi VITE_USE_MOCK_API=false. Khi bật mock, app tự dùng mockFirebaseConfig (src/config/firebase.config.js).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
